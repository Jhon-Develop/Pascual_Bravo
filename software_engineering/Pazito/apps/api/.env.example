# Pazito API - copia a apps/api/.env. Nunca comitees .env real.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
DATABASE_URL=mysql://pazito:pazito_dev_only@127.0.0.1:3306/pazito
DATABASE_POOL_SIZE=10
# Genera con: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_NAME=pazito_session
SESSION_TTL_HOURS=168
PASSWORD_RESET_TTL_MINUTES=30
# Mail: `log` solo en desarrollo (link de reset devuelto en respuesta), `smtp` si configuras un proveedor.
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Pazito <no-reply@localhost>
# FK/FX: `frankfurter` (servicio externo gratuito, sin clave) o `disabled`.
FX_PROVIDER=frankfurter
FX_API_BASE_URL=https://api.frankfurter.dev/v1
FX_TIMEOUT_MS=3500
FX_CACHE_HOURS=24
# Recibos: almacenamiento local privado, no servido directamente por Express.
RECEIPTS_DIR=./var/receipts
RECEIPTS_MAX_BYTES=5242880
# CORS y seguridad
TRUST_PROXY=false
LOG_LEVEL=info
