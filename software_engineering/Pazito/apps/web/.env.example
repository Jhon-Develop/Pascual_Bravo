# Pazito - Variables de entorno
# Copia este archivo a .env y completa los valores

# ============================================
# API Backend
# ============================================
# URL base del API REST (versión v1)
# Ejemplo desarrollo local: http://localhost:3000/api/v1
# Producción debe apuntar a la URL real y HTTPS del backend.
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# ============================================
# Modo Demo (desarrollo sin backend)
# ============================================
# Si true, usa datos simulados en memoria y no llama al API real
# Útil para desarrollo de UI sin necesidad de backend corriendo
PUBLIC_DEMO_MODE=false

# ============================================
# Configuración de la app
# ============================================
# Nombre de la app (para manifest PWA)
PUBLIC_APP_NAME=Pazito

# Descripción corta (para manifest PWA)
PUBLIC_APP_DESCRIPTION=Registra y divide gastos compartidos sin conflictos

# Moneda por defecto (ISO 4217)
PUBLIC_DEFAULT_CURRENCY=COP

# Locale por defecto
PUBLIC_DEFAULT_LOCALE=es-CO

# ============================================
# Analytics / Tracking (opcional)
# ============================================
# ID de Google Analytics / Matomo / etc.
# PUBLIC_ANALYTICS_ID=

# ============================================
# Feature Flags (opcional)
# ============================================
# Habilitar modo offline experimental
# PUBLIC_ENABLE_OFFLINE=true

# Habilitar notificaciones push
# PUBLIC_ENABLE_PUSH=false