{
  "name": "@pazito/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "bun run --cwd ../../packages/contracts build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "bun run --cwd ../../packages/contracts build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretypecheck": "bun run --cwd ../../packages/contracts build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:studio": "drizzle-kit studio",
    "audit": "bun audit",
    "openapi:check": "tsx src/scripts/check-openapi.ts"
  },
  "dependencies": {
    "@pazito/contracts": "workspace:*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "file-type": "^20.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.1",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.17.1",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.4",
    "typescript-eslint": "^8.34.1",
    "@eslint/js": "^9.28.0"
  }
}
