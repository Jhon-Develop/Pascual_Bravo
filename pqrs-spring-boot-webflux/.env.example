# =============================
# PROFILE / APP
# =============================
SPRING_PROFILES_ACTIVE=dev
PORT=8080
SEED_DATA_ENABLED=true
PQRS_MONITOR_CRON=0 0 * * * *

# =============================
# MYSQL LOCAL / CLEVER CLOUD (R2DBC + Flyway JDBC)
# Local/Docker: r2dbc. Clever Cloud with TLS: r2dbcs.
R2DBC_URL_PREFIX=r2dbc
# =============================
# Local: use DB_* variables.
# Clever Cloud injects MYSQL_ADDON_* automatically when the MySQL add-on is linked.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pqrs
DB_USERNAME=pqrs_app
DB_PASSWORD=change_me
DB_USE_SSL=false
DB_REQUIRE_SSL=false

# =============================
# GMAIL SMTP
# =============================
# Use a Gmail App Password, not your normal Gmail account password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_FROM=tu_correo@gmail.com
MAIL_FROM_NAME=PQRS Microservice
